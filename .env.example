# ========================================================
# CampusPulse - Smart College Attendance Management System
# Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super-secret-college-attendance-key-2026

# Database Configuration (SQLite)
DATABASE_URL=./db/database.sqlite

# Client Application URL (For CORS policies)
FRONTEND_URL=http://localhost:5173

# Verification & Biometric Engine
# Options: DEVELOPMENT_ONLY_MOCK_VERIFIER | AWS_REKOGNITION | AZURE_FACE
IS_DEV_MODE=true
BIOMETRIC_PROVIDER=DEVELOPMENT_ONLY_MOCK_VERIFIER
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
